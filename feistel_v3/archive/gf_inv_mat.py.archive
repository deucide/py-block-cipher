#gf element class + helper func
def GETVAL(i):
    if isinstance(i, GF_ELEM):
        return i.value
    elif isinstance(i, int):
        return i
    raise TypeError(f'GETVAL: i is not of type GF_ELEM or int but of {type(i)}')
class GF_ELEM (int):
    #constructor
    def __init__(self, value:int):
        self.value=value
    #overloads
    def __add__(self, other):
        return GF_ELEM(GETVAL(self)^GETVAL(other))
    def __sub__(self, other):
        return GF_ELEM(GETVAL(self)^GETVAL(other))
    def __mul__(self, other):
        #getting values from self, other
        self_val = GETVAL(self)
        other_val = GETVAL(other)
        #multiplication on gf(2**8)/<x8+x7+x5+x+1>
        other_val=str(bin(other_val))[2:]
        o, p=[], 0
        for i in range(len(other_val)):
            if int(other_val[::-1][i]):
                o.append(self_val<<i)
        for i in o:
            p^=i
        for i in range(len(str(bin(p)))-11, -1, -1):
            if p>=p^(419<<i):
                p^=419<<i
        return GF_ELEM(p)
    def __truediv__(self, other):
        #getting values from self, other
        self_val = GETVAL(self)
        other_val = GETVAL(other)
        #div on gf(2^8)/<x8+x7+x5+x+1>
        #where k*other=self, returns self/other ie k
        if self_val==0:
            return GF_ELEM(0)
        for k in range(0, 256):
            if GF_ELEM.__mul__(other, k) == self_val:
                return GF_ELEM(k)
        raise ValueError('GF_ELEM.__truediv__: can not find multiplicative inverse, check field definition')
    def __eq__(self, other):
        return GETVAL(self)==GETVAL(other)

#invert
def inv_over_gf(matrix):
    n = len(matrix)
    #make identity mat + augment
    identity = [
        [
            GF_ELEM(1) if i == j
            else GF_ELEM(0)
            for j in range(n)
        ]
        for i in range(n)
    ]
    augmented = [row[:]+identity_row for row, identity_row in zip(matrix, identity)]
    #gaussian elim
    for i in range(n):
        #all 1's for the diagonal
        if augmented[i][i] == GF_ELEM(0):
            for j in range(i+1, n):
                if augmented[j][i] != GF_ELEM(0):
                    augmented[i], augmented[j] = augmented[j], augmented[i]
                    break
        #normalize pivot
        pivot = augmented[i][i]
        for j in range(i, 2 * n):
            augmented[i][j] = augmented[i][j] / pivot
        #elim current column
        for j in range(n):
            if j != i:
                factor = augmented[j][i]
                for k in range(i, 2 * n):
                    augmented[j][k] -= factor * augmented[i][k]
    #get right half + return
    inverse = [row[n:] for row in augmented]
    return inverse