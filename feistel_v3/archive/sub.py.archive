# file showing how sboxes were generated

def m(a, b):
    #multiplication on gf(2**8)/<x8+x7+x5+x+1>
    b=str(bin(b))[2:]
    o, p=[], 0
    for i in range(len(b)):
        if int(b[::-1][i]):
            o.append(a<<i)
    for i in o:
        p^=i
    for i in range(len(str(bin(p)))-11, -1, -1):
        if p>=p^(419<<i):
            p^=419<<i
    return p
def d(u, a):
    #where a*b=u, returns u/a ie b
    #on gf(2^8)/<x8+x7+x5+x+1>
    if a==0:
        return 0
    for b in range(0, 256):
        if m(a,b) == u:
            return b
    return -1
INIT1 = 0b01100101
DIFF1 = [
    #randomly generated
    #although each has ideal hamming weight of 4
    #but couldnt find any setup of DIFF that fit
    #so resorted to mixed weights of 4s and 5s
    0b10110110,
    0b10010101,
    0b01101011,
    0b01110101,
    0b10101001,
    0b01000111,
    0b00110101,
    0b01111000,
]
INIT2 = 0b10100011
DIFF2 = [
    #see diff1 for same remarks
    0b01010110,
    0b10111001,
    0b01110010,
    0b10110100,
    0b11101010,
    0b11000111,
    0b10101101,
    0b01101101,
]
def sub(i): #nyberg sbox
    #map to multiplicative inverse on gf
    i=d(1,i)

    #equal to affine transform
    o = INIT1 #initial constant
    for _i in range(8):
        if i&(1<<_i):
            o^=DIFF1[_i] #adding differential
    return o
print([sub(i) for i in range(256)])

#finding inverse sbox is trivial