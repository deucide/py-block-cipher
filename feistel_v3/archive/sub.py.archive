# file showing how sboxes were generated

def m(a, b):
    #multiplication on gf(2**8)/<x8+x7+x5+x+1>
    b=str(bin(b))[2:]
    o, p=[], 0
    for i in range(len(b)):
        if int(b[::-1][i]):
            o.append(a<<i)
    for i in o:
        p^=i
    for i in range(len(str(bin(p)))-11, -1, -1):
        if p>=p^(419<<i):
            p^=419<<i
    return p
def d(u, a):
    #where a*b=u, returns u/a ie b
    #on gf(2^8)/<x8+x7+x5+x+1>
    if a==0:
        return 0
    for b in range(0, 256):
        if m(a,b) == u:
            return b
    return -1
INIT1 = 0b01100101 #randomly gen.d
DIFF1 = [
    0b01010111,
    0b10101110,
    0b01011101,
    0b10111010,
    0b01110101,
    0b11101010,
    0b11010101,
    0b10101011,
]
INIT2 = 0b10100011 #randomly gen.d
DIFF2 = [
    0b11001011,
    0b10010111,
    0b00101111,
    0b01011110,
    0b10111100,
    0b01111001,
    0b11110010,
    0b11100101,
]
def sub(i): #nyberg sbox
    #map to multiplicative inverse on gf
    i=d(1,i)

    #equal to affine transform
    o = INIT2 #initial constant
    for _i in range(8):
        if i&(1<<_i):
            o^=DIFF2[_i] #adding differential
    return o
print([sub(i) for i in range(256)])

#finding inverse sbox is trivial